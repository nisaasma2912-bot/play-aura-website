-- Play Aura Game Suggestions & Visitor Moderation Migration
-- Safe, additive migration: preserves all existing tables, data, and admin authorization.

-- 1. Game Suggestions table
create table if not exists public.game_suggestions (
  id uuid primary key default gen_random_uuid(),
  message text not null check (char_length(trim(message)) between 5 and 400),
  visitor_token_hash text not null check (visitor_token_hash ~ '^[a-f0-9]{64}$'),
  status text not null default 'new' check (status in ('new', 'reviewed', 'archived')),
  created_at timestamptz not null default now()
);

create index if not exists idx_game_suggestions_created_at
  on public.game_suggestions (created_at desc);

create index if not exists idx_game_suggestions_status
  on public.game_suggestions (status);

create index if not exists idx_game_suggestions_visitor_created
  on public.game_suggestions (visitor_token_hash, created_at desc);

-- 2. Blocked Suggestion Visitors table
create table if not exists public.blocked_suggestion_visitors (
  id uuid primary key default gen_random_uuid(),
  visitor_token_hash text not null unique check (visitor_token_hash ~ '^[a-f0-9]{64}$'),
  reason text not null default '',
  created_at timestamptz not null default now(),
  blocked_by uuid references auth.users(id) on delete set null
);

create index if not exists idx_blocked_suggestion_visitors_created_at
  on public.blocked_suggestion_visitors (created_at desc);

-- 3. Preserve existing admin helper if already installed; create only if missing
do $$
begin
  if to_regprocedure('public.is_playaura_admin()') is null then
    execute $fn$
      create function public.is_playaura_admin()
      returns boolean
      language sql
      security definer
      stable
      set search_path = public, pg_temp
      as $body$
        select exists (
          select 1 from public.admin_users where user_id = auth.uid()
        );
      $body$;
    $fn$;
  end if;
end
$$;

-- 4. Enable strict Row Level Security
alter table public.game_suggestions enable row level security;
alter table public.blocked_suggestion_visitors enable row level security;

-- Lock down direct table access from public / anon roles.
-- Public visitors submit ONLY through the validated SECURITY DEFINER RPC below
-- and can never list, read, update, or delete suggestions or block records.
revoke all on table public.game_suggestions from public, anon;
revoke all on table public.blocked_suggestion_visitors from public, anon;
grant select, update, delete on table public.game_suggestions to authenticated;
grant select, insert, update, delete on table public.blocked_suggestion_visitors to authenticated;

-- 5. Admin-only RLS policies (reusing existing public.is_playaura_admin())
drop policy if exists "Admins can view game suggestions" on public.game_suggestions;
create policy "Admins can view game suggestions"
on public.game_suggestions for select
to authenticated
using (public.is_playaura_admin());

drop policy if exists "Admins can update game suggestions" on public.game_suggestions;
create policy "Admins can update game suggestions"
on public.game_suggestions for update
to authenticated
using (public.is_playaura_admin())
with check (public.is_playaura_admin());

drop policy if exists "Admins can delete game suggestions" on public.game_suggestions;
create policy "Admins can delete game suggestions"
on public.game_suggestions for delete
to authenticated
using (public.is_playaura_admin());

drop policy if exists "Admins can view blocked suggestion visitors" on public.blocked_suggestion_visitors;
create policy "Admins can view blocked suggestion visitors"
on public.blocked_suggestion_visitors for select
to authenticated
using (public.is_playaura_admin());

drop policy if exists "Admins can block suggestion visitors" on public.blocked_suggestion_visitors;
create policy "Admins can block suggestion visitors"
on public.blocked_suggestion_visitors for insert
to authenticated
with check (public.is_playaura_admin());

drop policy if exists "Admins can update blocked suggestion visitors" on public.blocked_suggestion_visitors;
create policy "Admins can update blocked suggestion visitors"
on public.blocked_suggestion_visitors for update
to authenticated
using (public.is_playaura_admin())
with check (public.is_playaura_admin());

drop policy if exists "Admins can unblock suggestion visitors" on public.blocked_suggestion_visitors;
create policy "Admins can unblock suggestion visitors"
on public.blocked_suggestion_visitors for delete
to authenticated
using (public.is_playaura_admin());

-- 6. Server-side validated submission RPC for visitors
-- Checks message validity, URL/spam rules, blocked visitor hash, rate limits, and duplicate submissions.
create or replace function public.submit_game_suggestion(
  p_message text,
  p_visitor_token_hash text
)
returns jsonb
language plpgsql
security definer
set search_path = public, pg_temp
as $$
declare
  v_clean_message text;
  v_clean_hash text;
  v_recent_count integer;
  v_daily_count integer;
  v_duplicate_exists boolean;
  v_new_id uuid;
begin
  v_clean_message := btrim(regexp_replace(coalesce(p_message, ''), '[ \t]+', ' ', 'g'), E' \t\r\n');
  v_clean_hash := lower(btrim(coalesce(p_visitor_token_hash, '')));

  if char_length(v_clean_message) < 5 then
    return jsonb_build_object(
      'ok', false,
      'code', 'too_short',
      'error', 'Please share a few more details (at least 5 characters).'
    );
  end if;

  if char_length(v_clean_message) > 400 then
    return jsonb_build_object(
      'ok', false,
      'code', 'too_long',
      'error', 'Suggestions must be 400 characters or fewer.'
    );
  end if;

  if v_clean_hash !~ '^[a-f0-9]{64}$' then
    return jsonb_build_object(
      'ok', false,
      'code', 'invalid_visitor',
      'error', 'Unable to verify your browser session. Please refresh and try again.'
    );
  end if;

  if v_clean_message ~* '(https?://|www\.)' then
    return jsonb_build_object(
      'ok', false,
      'code', 'links_not_allowed',
      'error', 'Links and website addresses are not allowed in game suggestions.'
    );
  end if;

  -- Check if this anonymous visitor token hash has been blocked by an admin
  if exists (
    select 1
    from public.blocked_suggestion_visitors b
    where b.visitor_token_hash = v_clean_hash
  ) then
    return jsonb_build_object(
      'ok', false,
      'code', 'blocked',
      'error', 'Suggestions are currently unavailable from this browser.'
    );
  end if;

  -- Rate limit: 1 suggestion per 60 seconds per visitor token hash
  select count(*)
    into v_recent_count
  from public.game_suggestions gs
  where gs.visitor_token_hash = v_clean_hash
    and gs.created_at > now() - interval '60 seconds';

  if v_recent_count > 0 then
    return jsonb_build_object(
      'ok', false,
      'code', 'rate_limited',
      'error', 'Please wait a minute before submitting another game suggestion.'
    );
  end if;

  -- Daily cap: max 5 suggestions per 24 hours per visitor token hash
  select count(*)
    into v_daily_count
  from public.game_suggestions gs
  where gs.visitor_token_hash = v_clean_hash
    and gs.created_at > now() - interval '24 hours';

  if v_daily_count >= 5 then
    return jsonb_build_object(
      'ok', false,
      'code', 'daily_limit',
      'error', 'You have reached the daily suggestion limit. Please try again tomorrow!'
    );
  end if;

  -- Duplicate check within 24 hours
  select exists (
    select 1
    from public.game_suggestions gs
    where gs.visitor_token_hash = v_clean_hash
      and lower(gs.message) = lower(v_clean_message)
      and gs.created_at > now() - interval '24 hours'
  ) into v_duplicate_exists;

  if v_duplicate_exists then
    return jsonb_build_object(
      'ok', false,
      'code', 'duplicate',
      'error', 'You already sent this game suggestion recently. Thank you!'
    );
  end if;

  insert into public.game_suggestions (message, visitor_token_hash, status)
  values (v_clean_message, v_clean_hash, 'new')
  returning id into v_new_id;

  return jsonb_build_object(
    'ok', true,
    'code', 'created',
    'id', v_new_id
  );
end;
$$;

revoke all on function public.submit_game_suggestion(text, text) from public;
grant execute on function public.submit_game_suggestion(text, text) to anon, authenticated;

-- Refresh PostgREST schema cache immediately
notify pgrst, 'reload schema';
